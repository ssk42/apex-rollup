# Salesforce Environment Configuration for E2E Testing
# Copy this file to .env and update with your org credentials
# NOTE: If you have a scratch org configured, these variables are optional
# The tests will automatically use the scratch org if available

# Optional Manual Salesforce Credentials (fallback if no scratch org)
SF_USERNAME=your-username@example.com
SF_PASSWORD=your-password-and-security-token
SF_LOGIN_URL=https://login.salesforce.com

# Optional Configuration
SF_ORG_ID=your-org-id
SF_INSTANCE_URL=https://your-instance.salesforce.com

# Scratch Org Configuration (automatically detected)
# SCRATCH_ORG_ALIAS=apex-rollup-scratch-org (default)

# Test Configuration
HEADLESS=true
SLOW_MO=0
TEST_TIMEOUT=120000
DEBUG_MODE=false

# Test Data Cleanup
AUTO_CLEANUP=true
PRESERVE_TEST_DATA=false

# Reporting
GENERATE_REPORTS=true
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true