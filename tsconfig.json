{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@/utils/*": ["tests/e2e-playwright/utils/*"],
      "@/fixtures/*": ["tests/e2e-playwright/fixtures/*"],
      "@/types/*": ["tests/e2e-playwright/types/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": ["tests/e2e-playwright/**/*", "playwright.config.ts", "playwright.comprehensive.config.ts"],
  "exclude": ["node_modules", "dist", "test-results"]
}
